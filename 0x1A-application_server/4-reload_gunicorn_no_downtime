#!/usr/bin/env bash
# This script gracefully reloads the Gunicorn server

# Find the process ID (PID) of the master Gunicorn process
PID=$(pgrep -f 'gunicorn.*master')

# If the PID exists, send the HUP signal to gracefully reload Gunicorn
if [ -n "$PID" ]; then
    echo "Reloading Gunicorn (PID: $PID)..."
    kill -HUP "$PID"
    echo "Gunicorn reloaded successfully."
else
    echo "Gunicorn master process not found. Make sure Gunicorn is running."
fi
